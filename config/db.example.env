# Copy to config/db.env and fill in. config/db.env is gitignored.
AEGIS_DB_HOST=127.0.0.1
AEGIS_DB_PORT=3306
AEGIS_DB_USER=aegis
AEGIS_DB_PASSWORD=change_me
# The schema name is FIXED at `aegis`. sql/00_setup/00_create_database.sql
# creates it by name and all 21 SQL files begin `USE aegis;`, so changing this
# would point the Python connection at one schema while every SQL statement
# wrote to another — the quality gate would then read an empty dq_results and
# report a clean run against a database it never touched. Left here, and left
# fixed, rather than offered as a setting that silently does not work.
AEGIS_DB_NAME=aegis

# Quarters to ingest, inclusive. FAERS publishes from 2004Q1.
# The full archive is ~40 GB uncompressed; start narrow and widen.
AEGIS_START_QUARTER=2019Q1
AEGIS_END_QUARTER=2025Q1

# Where downloaded FAERS zips land (gitignored)
AEGIS_RAW_DIR=data/raw
